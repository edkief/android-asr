{
  "harness": "pi",
  "maxIterations": 20,
  "pinTask": true,
  "model": "minimax/MiniMax-M3",
  "timeouts": {
    "iterationMs": 2700000,
    "inactivityMs": 300000,
    "wrapUpMs": 600000,
    "confirmMs": 300000,
    "askMs": 0
  },
  "retries": {
    "providerRetriesPerIteration": 3,
    "iterationRetries": 1,
    "earlyStopResumes": 2,
    "backoffMs": 15000
  },
  "stall": {
    "maxUnproductiveIterations": 3,
    "maxTimeoutsPerTask": 2
  },
  "assess": {
    "mode": "off"
  },
  "escalation": {
    "enabled": false
  },
  "permissions": {
    "fallback": "allow",
    "deny": ["git push", "git remote", "rm -rf /", "shutdown", "reboot"]
  },
  "git": {
    "push": "iteration",
    "forcePush": true,
    "remote": "origin"
  },
  "ui": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 4280,
    "actions": "open",
    "push": {
      "enabled": true,
      "forcePush": true,
      "subject": "mailto:you@example.com"
    }
  },
  "log": {
    "format": "text",
    "level": "info"
  }
}

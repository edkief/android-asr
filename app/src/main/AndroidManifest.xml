<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The model downloader fetches ASR, segmentation and embedding
        weights from Hugging Face / GitHub Releases over HTTPS on first
        run; no other network calls live in the app today.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Required by `audio.MicAudioSource` (TASK-9). The runtime
        permission is requested by the recording service / setup
        screen; the class itself is a thin wrapper around
        `AudioRecord` and cannot check it.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".ConvoApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.ConvoScribe"
        android:largeHeap="true">
        <!--
            libcdsprpc.so is the userspace half of the Hexagon DSP RPC
            driver. The QNN HTP backend loads the *.so Skel/Stub pair via
            this library, so on a device without it we cannot create the
            NPU backend. Marking it required="false" lets the APK still
            install on devices/emulators that lack the DSP; QNN device
            creation will fail with error 14001 at runtime if so.
        -->
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>